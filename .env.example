# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Owner Configuration
# Format: number1|number2|number3 (separate multiple owners with pipe)
# Example: 558881647724|61488873561
BOT_OWNER_NUMBER=YOUR_NUMBER_HERE

# Moderator Numbers (comma-separated)
BOT_MODS=558881647724

# Premium Users (comma-separated)
BOT_PREMIUMS=558881647724

# Database Configuration
# Options: json | mongodb
DB_TYPE=json
DB_PATH=./database.json

# MongoDB URI (if using MongoDB)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# API Configuration
# FG Mods API
FG_MODS_API_URL=https://api.fgmods.xyz
FG_MODS_API_KEY=your_api_key_here

# API Timeouts (in milliseconds)
API_TIMEOUT=30000

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg

# Bot Prefix
BOT_PREFIX=^[‎z/i!#$%+£¢€¥^°=¶∆×÷π√✓©®:;?&.,\-]

# Features
ENABLE_CHATBOT=true
ENABLE_AUTO_LEVELUP=false
ENABLE_ANTI_LINK=false

# Keep Alive (Replit/Heroku)
KEEP_ALIVE=false
KEEP_ALIVE_URL=

# Logging
LOG_LEVEL=info

# Language
DEFAULT_LANGUAGE=pt

# Security
# Set to false in production
DEBUG_MODE=false
